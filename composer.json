{
    "name": "esanj/auth-bridge",
    "description": "OAuth 2.0 Bridge package for connecting to external authorization servers.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Esanj Tech Team",
            "email": "tech@esanj.ir"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "firebase/php-jwt": "^7.0",
        "illuminate/cache": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/events": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/log": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/session": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "psr/log": "^1.0|^2.0|^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0|^12.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Esanj\\AuthBridge\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Esanj\\AuthBridge\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Esanj\\AuthBridge\\AuthBridgeServiceProvider"
            ],
            "aliases": {
                "AuthBridge": "Esanj\\AuthBridge\\Facades\\AuthBridge"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
